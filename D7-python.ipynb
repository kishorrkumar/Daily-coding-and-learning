   "source": [
    "#1. Palindrome number\n",
    "\n",
    "num= int(input(\"Enter thhe number: \"))\n",
    "original = num\n",
    "rev = 0\n",
    "\n",
    "while num > 0:\n",
    "    digit = num%10\n",
    "    rev = rev*10 + digit\n",
    "    num = num//10\n",
    "\n",
    "if original == num:\n",
    "    print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"Not Palindrome\")\n",
    "\n",
    "    "
   ]
